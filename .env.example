# Copy this file to .env for local development only. Replace every placeholder before use.
# Production secrets belong in a secret manager; never deploy this template unchanged.
ALLSHOP_ENV=development
ALLSHOP_APP_URL=http://localhost:8000
ALLSHOP_DB_PATH=
ALLSHOP_APP_KEY=replace-with-a-random-secret-at-least-32-characters
ALLSHOP_SECURE_COOKIES=false
ALLSHOP_ADMIN_USERNAME=change-this-admin-name
ALLSHOP_ADMIN_PASSWORD=replace-with-a-random-unique-password-of-20-chars

# bKash credentials are issued by bKash. Keep them private and server-side.
ALLSHOP_BKASH_ENV=sandbox
ALLSHOP_BKASH_APP_KEY=
ALLSHOP_BKASH_APP_SECRET=
ALLSHOP_BKASH_USERNAME=
ALLSHOP_BKASH_PASSWORD=
